load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//docs/site:astro/package_json.bzl", astro = "bin")
load("@rules_python//python:defs.bzl", "py_test")
load("//docs/tools/docs:site_rules.bzl", "publish_file", "site_revision")
load(":version.bzl", "site_version")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".npmrc",
    ".nvmrc",
    "package.json",
    "pnpm-lock.yaml",
])

npm_link_all_packages()

astro.astro_binary(
    name = "astro",
)

site_version(
    name = "version_file",
    source = "//:VERSION",
)

publish_file(
    name = "daemon_rpc_openapi",
    output = "public/spec/reference/daemon-rpc.openapi.json",
    source = "//docs/site/spec:reference/daemon-rpc.openapi.json",
)

site_revision(
    name = "site_revision",
    client_output = "public/assets/site-refresh.js",
    generator = "//docs/tools/docs:site_revision",
    revision_output = "public/assets/site-revision.json",
    sources = glob([
        "public/**",
        "src/**",
    ]) + [
        "astro.config.mjs",
        "package.json",
        "tsconfig.json",
        ":daemon_rpc_openapi",
        ":version_file",
    ],
)

filegroup(
    name = "site_sources",
    srcs = glob([
        "public/**",
        "src/**",
    ]) + [
        "astro.config.mjs",
        "package.json",
        "tsconfig.json",
        ":daemon_rpc_openapi",
        ":site_revision",
        ":version_file",
    ],
)

js_run_binary(
    name = "astro_site",
    srcs = [
        ":node_modules/astro",
        ":node_modules/tidewave",
        ":site_sources",
    ],
    args = ["build"],
    chdir = package_name(),
    env = {
        "ASTRO_CACHE_DIR": "dist/.astro-cache",
        "ASTRO_TELEMETRY_DISABLED": "1",
    },
    out_dirs = ["dist"],
    tool = ":astro",
)

astro.astro_binary(
    name = "astro_dev",
    chdir = package_name(),
    data = [
        ":node_modules/astro",
        ":node_modules/tidewave",
        ":site_sources",
    ],
    env = {
        "ASTRO_CACHE_DIR": "dist/.astro-cache",
        "ASTRO_DEV_BACKGROUND": "0",
        "ASTRO_TELEMETRY_DISABLED": "1",
        "BAZEL_BINDIR": ".",
    },
)

astro.astro_binary(
    name = "astro_dev_tidewave",
    chdir = package_name(),
    data = [
        ":node_modules/astro",
        ":node_modules/tidewave",
        ":site_sources",
    ],
    env = {
        "ASTRO_CACHE_DIR": "dist/.astro-cache",
        "ASTRO_DEV_BACKGROUND": "0",
        "ASTRO_TELEMETRY_DISABLED": "1",
        "BAZEL_BINDIR": ".",
        "HOVEL_TIDEWAVE": "1",
    },
)

py_test(
    name = "report_ui_test",
    size = "small",
    srcs = ["report_ui_test.py"],
    args = [
        "$(rootpath :public/assets/report.js)",
        "$(rootpath :public/assets/report.css)",
    ],
    data = [
        "public/assets/report.css",
        "public/assets/report.js",
    ],
    python_version = "PY3",
)

py_test(
    name = "site_smoke_test",
    size = "small",
    srcs = ["//core/tools/tests:site_smoke_test.py"],
    args = ["$(rootpath :astro_site)"],
    data = [":astro_site"],
    python_version = "PY3",
)

py_test(
    name = "daemon_rpc_openapi_test",
    size = "small",
    srcs = ["//docs/tools/docs:daemon_rpc_openapi_test.py"],
    args = [
        "$(rootpath :daemon_rpc_openapi)",
        "$(rootpath //core/internal/adapters/daemonrpc:daemonrpc_source)",
        "$(rootpath :src/content/spec/daemon-rpc.html)",
    ],
    data = [
        "src/content/spec/daemon-rpc.html",
        ":daemon_rpc_openapi",
        "//core/internal/adapters/daemonrpc:daemonrpc_source",
    ],
    python_version = "PY3",
    deps = [
        "@lint_pypi//jsonschema",
        "@lint_pypi//pytest",
    ],
)

py_test(
    name = "provider_docs_parity_test",
    size = "small",
    srcs = ["//docs/tools/docs:provider_docs_parity_test.py"],
    data = [
        "src/content/spec/module-protocol.html",
        "//:sdk/go/README.md",
        "//:sdk/rust/README.md",
        "//docs/tools/docs:python_api/index.rst",
        "//sdk/go/hovel:protocol_doc_sources",
        "//sdk/python:README.md",
        "//sdk/python:sources",
        "//sdk/rust/hovel:protocol_doc_sources",
    ],
    python_version = "PY3",
    deps = ["@lint_pypi//pytest"],
)

