load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "protocol_doc_sources",
    srcs = [
        "src/chain_kv.rs",
        "src/credential_delivery.rs",
        "src/credential_provider.rs",
        "src/mesh.rs",
        "src/mesh_bridge.rs",
        "src/server.rs",
    ],
)

rust_library(
    name = "hovel",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "hovel",
    edition = "2021",
)

rust_test(
    name = "hovel_test",
    size = "small",
    crate = ":hovel",
    edition = "2021",
)

rust_test(
    name = "hovel_coverage_test",
    size = "small",
    crate = ":hovel",
    edition = "2021",
    rustc_env = {"RUSTC_BOOTSTRAP": "1"},
    rustc_flags = [
        "-Cinstrument-coverage",
        "-Clink-dead-code",
        "-Zcoverage-options=branch",
    ],
)

# BEGIN generated lint sources
filegroup(
    name = "hovel_lint_sources",
    srcs = [
        "BUILD.bazel",
        "src/base64.rs",
        "src/chain_kv.rs",
        "src/context.rs",
        "src/credential_delivery.rs",
        "src/credential_provider.rs",
        "src/framing.rs",
        "src/json.rs",
        "src/lib.rs",
        "src/mesh.rs",
        "src/mesh_bridge.rs",
        "src/module.rs",
        "src/payload.rs",
        "src/result.rs",
        "src/server.rs",
        "src/session.rs",
        "src/sha256.rs",
        "src/tests.rs",
    ],
    visibility = ["//tools/lint:__pkg__"],
)
# END generated lint sources
