load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "pyproject.toml",
    "uv.lock",
])

filegroup(
    name = "sources",
    srcs = glob(["hovel_sdk/*.py"]),
)

py_binary(
    name = "build_dist",
    srcs = ["build_dist.py"],
    data = [
        "README.md",
        ":pyproject.toml",
        ":sources",
    ],
    python_version = "PY3",
)

py_library(
    name = "hovel_sdk",
    srcs = glob(["hovel_sdk/*.py"]),
    imports = ["."],
)

filegroup(
    name = "hovel_sdk_test_sources",
    srcs = ["hovel_sdk/sdk_test.py"],
)

filegroup(
    name = "mesh_bridge_test_sources",
    srcs = ["hovel_sdk/mesh_bridge_test.py"],
)

filegroup(
    name = "coverage_test_sources",
    srcs = ["hovel_sdk/coverage_test.py"],
)

py_test(
    name = "hovel_sdk_test",
    size = "small",
    srcs = ["hovel_sdk/sdk_test.py"],
    imports = ["."],
    main = "hovel_sdk/sdk_test.py",
    python_version = "PY3",
    deps = [
        ":hovel_sdk",
        "@lint_pypi//pytest",
    ],
)

py_test(
    name = "mesh_bridge_test",
    size = "small",
    srcs = ["hovel_sdk/mesh_bridge_test.py"],
    imports = ["."],
    python_version = "PY3",
    deps = [
        ":hovel_sdk",
        "@lint_pypi//pytest",
    ],
)

py_test(
    name = "coverage_test",
    size = "small",
    srcs = ["hovel_sdk/coverage_test.py"],
    imports = ["."],
    deps = [
        ":hovel_sdk",
        "@lint_pypi//pytest",
    ],
)

# BEGIN generated lint sources
filegroup(
    name = "hovel_lint_sources",
    srcs = [
        "BUILD.bazel",
        "README.md",
        "build_dist.py",
        "hovel_sdk/__init__.py",
        "hovel_sdk/config.py",
        "hovel_sdk/context.py",
        "hovel_sdk/coverage_test.py",
        "hovel_sdk/credential_delivery.py",
        "hovel_sdk/credential_provider.py",
        "hovel_sdk/framing.py",
        "hovel_sdk/logging.py",
        "hovel_sdk/mesh.py",
        "hovel_sdk/mesh_bridge.py",
        "hovel_sdk/mesh_bridge_test.py",
        "hovel_sdk/module.py",
        "hovel_sdk/payload.py",
        "hovel_sdk/result.py",
        "hovel_sdk/sdk_test.py",
        "hovel_sdk/server.py",
        "hovel_sdk/session.py",
        "hovel_sdk/testing.py",
        "pyproject.toml",
        "uv.lock",
    ],
    visibility = ["//tools/lint:__pkg__"],
)
# END generated lint sources
