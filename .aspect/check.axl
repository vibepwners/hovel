load(".aspect/helpers.axl", "run_steps")

def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    scopes = {
        "repo": [
            (["run", "//repo-tools/tasks:lint_sources", "--", "--check"], root),
            (["test", "//tools/lint:buildifier_test", "//tools/lint:policy_test"], root),
            (["test", "//:repo_quality_test"], root),
        ],
        "core": [
            (["test", "//tools/lint:core_gofmt_test", "//tools/lint:core_golangci_test", "//tools/lint:core_gazelle_test"], root),
            (["build", "//:build"], root + "/core"),
            (["test", "//:ci_test", "//:race_test", "//:fuzz_smoke_test"], root + "/core"),
            (["test", "--bazel-flag=--collect_code_coverage", "--bazel-flag=--combined_report=lcov", "--bazel-flag=--remote_download_outputs=all", "//internal/domain/...", "//internal/app/..."], root + "/core"),
            (["run", "//tools/tests:check_coverage", "--", "--analyze-go-report"], root + "/core"),
        ],
        "sdk": [
            (["test", "//tools/lint:ruff_test", "//tools/lint:mypy_test", "//tools/lint:pydoclint_test", "//tools/lint:rustfmt_test"], root),
            (["build", "//:sdk_build"], root),
            (["test", "//:sdk_test"], root),
        ],
        "module-examples": [
            (["build", "//:module_examples_build"], root),
            (["test", "//:module_examples_test"], root),
        ],
        "modules": [
            (["test", "//tools/lint:gofmt_modules_test", "//tools/lint:picblobs_ruff_test", "//tools/lint:picblobs_clang_format_test", "//tools/lint:picblobs_lizard_test"], root),
            (["build", "//:modules_build"], root),
            (["test", "//:modules_test"], root),
            (["test", "--bazel-flag=--config=picblobs_ci", "//modules/picblobs:bazel_test_suite"], root),
        ],
        "docs": [
            (["test", "//:docs_test"], root),
            (["build", "//docs/tools/docs:site"], root),
        ],
        "agent": [
            (["test", "//agent/tools:package_agent_test"], root),
            (["run", "//agent/tools:package_agent", "--", "--validate"], root),
        ],
    }
    selected = ctx.args.scope[0]
    if selected == "all":
        steps = []
        for name in ["repo", "core", "sdk", "module-examples", "modules", "docs", "agent"]:
            steps.extend(scopes[name])
        return run_steps(ctx, steps)
    if selected not in scopes:
        print("unknown check scope: " + selected)
        return 2
    return run_steps(ctx, scopes[selected])

hovel_check = task(
    args = {"scope": args.positional(default = ["all"], minimum = 0, maximum = 1, description = "Scope: all, repo, core, sdk, module-examples, modules, docs, or agent.")},
    summary = "Run the complete non-publishing Hovel verification gate.",
    implementation = _impl,
)
