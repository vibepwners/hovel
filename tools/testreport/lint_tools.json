{
  "schema_version": "hovel.lint-tools/v1",
  "tools": [
    {
      "id": "gofmt",
      "name": "gofmt",
      "kind": "formatter",
      "scope": "Core and Squatter Go",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:core_gofmt_test",
          "//tools/lint:gofmt_modules_test"
        ]
      ],
      "ignore": {
        "pattern": "",
        "extensions": [
          ".go"
        ]
      }
    },
    {
      "id": "golangci-lint",
      "name": "golangci-lint",
      "kind": "linter",
      "scope": "Core Go",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:core_golangci_test"
        ]
      ],
      "ignore": {
        "pattern": "//\\s*nolint(?:\\b|:)",
        "extensions": [
          ".go"
        ]
      }
    },
    {
      "id": "gazelle",
      "name": "Gazelle",
      "kind": "static-analysis",
      "scope": "Core Go build metadata",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:core_gazelle_test"
        ]
      ],
      "ignore": {
        "pattern": "#\\s*gazelle:(?:exclude|ignore)\\b",
        "extensions": [
          ".bzl"
        ],
        "names": [
          "BUILD",
          "BUILD.bazel",
          "MODULE.bazel"
        ]
      }
    },
    {
      "id": "nilness",
      "name": "nogo nilness",
      "kind": "static-analysis",
      "scope": "Core Go build",
      "commands": [
        [
          "aspect",
          "build",
          "@hovel_core//:build"
        ]
      ],
      "ignore": {
        "pattern": "//\\s*nolint(?=\\s|$|(?::[^\\n]*\\bnilness\\b))",
        "extensions": [
          ".go"
        ]
      }
    },
    {
      "id": "buildifier",
      "name": "Buildifier",
      "kind": "linter",
      "scope": "Monorepo Bazel and Starlark",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:buildifier_test"
        ]
      ],
      "ignore": {
        "pattern": "#\\s*buildifier:\\s*(?:disable|leave-alone)\\b",
        "extensions": [
          ".bzl"
        ],
        "names": [
          "BUILD",
          "BUILD.bazel",
          "MODULE.bazel",
          "WORKSPACE",
          "WORKSPACE.bazel"
        ]
      }
    },
    {
      "id": "repository-policy",
      "name": "Repository policy",
      "kind": "static-analysis",
      "scope": "Architecture, visibility, and ownership",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:policy_test"
        ]
      ],
      "ignore": {
        "pattern": "",
        "extensions": [
          ".go",
          ".py",
          ".bzl"
        ]
      }
    },
    {
      "id": "ruff",
      "name": "Ruff",
      "kind": "linter",
      "scope": "SDK, examples, and Picblobs Python",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:ruff_test",
          "//tools/lint:picblobs_ruff_test"
        ]
      ],
      "ignore": {
        "pattern": "#\\s*(?:ruff:\\s*)?noqa\\b",
        "extensions": [
          ".py",
          ".pyi"
        ]
      }
    },
    {
      "id": "mypy",
      "name": "mypy",
      "kind": "static-analysis",
      "scope": "SDK and example Python",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:mypy_test"
        ]
      ],
      "ignore": {
        "pattern": "#\\s*type:\\s*ignore\\b",
        "extensions": [
          ".py",
          ".pyi"
        ]
      }
    },
    {
      "id": "pydoclint",
      "name": "pydoclint",
      "kind": "linter",
      "scope": "SDK and example Python documentation",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:pydoclint_test"
        ]
      ],
      "ignore": {
        "pattern": "#\\s*noqa:\\s*DOC[0-9]",
        "extensions": [
          ".py",
          ".pyi"
        ]
      }
    },
    {
      "id": "rustfmt",
      "name": "rustfmt",
      "kind": "formatter",
      "scope": "Rust SDK",
      "commands": [
        [
          "aspect",
          "test",
          "//tools/lint:rustfmt_test"
        ]
      ],
      "ignore": {
        "pattern": "#\\s*\\[(?:rustfmt::skip|rustfmt_skip)\\]",
        "extensions": [
          ".rs"
        ]
      }
    },
    {
      "id": "clang-format",
      "name": "clang-format",
      "kind": "formatter",
      "scope": "Squatter and Picblobs C",
      "commands": [
        [
          "aspect",
          "build",
          "//modules/squatter/windows/src:format_check"
        ],
        [
          "aspect",
          "test",
          "//tools/lint:picblobs_clang_format_test"
        ]
      ],
      "ignore": {
        "pattern": "clang-format\\s+off",
        "extensions": [
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp"
        ]
      }
    },
    {
      "id": "clang-tidy",
      "name": "clang-tidy",
      "kind": "static-analysis",
      "scope": "Squatter and Picblobs C",
      "commands": [
        [
          "aspect",
          "build",
          "//modules/squatter/windows/src:clang_tidy"
        ],
        [
          "aspect",
          "build",
          "--bazel-flag=--config=picblobs_lint",
          "//modules/picblobs/src/...",
          "//modules/picblobs/tests/..."
        ]
      ],
      "ignore": {
        "pattern": "(?:^|\\s)(?://|/\\*)\\s*NOLINT(?:NEXTLINE|BEGIN|END)?(?:\\([^)]*\\))?",
        "extensions": [
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp"
        ]
      }
    },
    {
      "id": "cppcheck",
      "name": "cppcheck",
      "kind": "static-analysis",
      "scope": "Squatter and Picblobs C",
      "commands": [
        [
          "aspect",
          "build",
          "//modules/squatter/windows/src:cppcheck"
        ],
        [
          "aspect",
          "test",
          "//modules/picblobs/tests/runners/freebsd:runner_cppcheck",
          "//modules/picblobs/tests/runners/linux:runner_cppcheck",
          "//modules/picblobs/tests/runners/windows:runner_cppcheck"
        ]
      ],
      "ignore": {
        "pattern": "cppcheck-suppress(?:-begin|-end)?\\b",
        "extensions": [
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp"
        ]
      }
    },
    {
      "id": "lizard",
      "name": "Lizard",
      "kind": "static-analysis",
      "scope": "Squatter C and Picblobs sources",
      "commands": [
        [
          "aspect",
          "build",
          "//modules/squatter/windows/src:complexity"
        ],
        [
          "aspect",
          "test",
          "//tools/lint:picblobs_lizard_test"
        ]
      ],
      "ignore": {
        "pattern": "#lizard\\s+forgive\\b",
        "extensions": [
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp",
          ".py"
        ]
      }
    }
  ]
}
