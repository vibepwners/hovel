load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/lint:results.bzl", "LINT_RESULTS")

package(default_visibility = ["//visibility:public"])

exports_files(["operator-parity.schema.json"])

py_binary(
    name = "render_report",
    srcs = [
        "render_report.py",
        "testreport.py",
    ],
    imports = ["."],
    main = "render_report.py",
    python_version = "PY3",
)

py_binary(
    name = "run_lint_report",
    srcs = [
        "lintreport.py",
        "run_lint_report.py",
    ],
    args = ["--result-dir=$(rootpath " + target + ")" for target in LINT_RESULTS],
    data = LINT_RESULTS + [
        "lint-report.schema.json",
        "lint_tools.json",
    ],
    imports = ["."],
    main = "run_lint_report.py",
    python_version = "PY3",
)

py_test(
    name = "lintreport_test",
    size = "small",
    srcs = [
        "lintreport.py",
        "lintreport_test.py",
    ],
    data = [
        "lint-report.schema.json",
        "lint_tools.json",
    ],
    imports = ["."],
    python_version = "PY3",
)

py_test(
    name = "testreport_test",
    size = "small",
    srcs = [
        "testreport.py",
        "testreport_test.py",
    ],
    imports = ["."],
    python_version = "PY3",
)

# BEGIN generated lint sources
filegroup(
    name = "hovel_lint_sources",
    srcs = [
        "BUILD.bazel",
        "README.md",
        "lint-report.schema.json",
        "lint_tools.json",
        "lintreport.py",
        "lintreport_test.py",
        "operator-parity.schema.json",
        "render_report.py",
        "run_lint_report.py",
        "testreport.py",
        "testreport_test.py",
    ],
    visibility = ["//tools/lint:__pkg__"],
)
# END generated lint sources
