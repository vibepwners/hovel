load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "terminallog",
    srcs = ["renderer.go"],
    importpath = "github.com/vibepwners/hovel/internal/adapters/terminallog",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/app/operatorlog",
        "@com_github_charmbracelet_lipgloss//:lipgloss",
