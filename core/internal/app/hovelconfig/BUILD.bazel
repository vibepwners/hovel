load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "hovelconfig",
    srcs = ["config.go"],
    importpath = "github.com/vibepwners/hovel/internal/app/hovelconfig",
    visibility = ["//:__subpackages__"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "hovelconfig_test",
    size = "small",
    srcs = ["config_test.go"],
    embed = [":hovelconfig"],
)

go_test(
    name = "hovelconfig_race_test",
    size = "small",
    srcs = ["config_test.go"],
    embed = [":hovelconfig"],
    race = "on",
    tags = ["manual"],
)

# BEGIN generated lint sources
filegroup(
    name = "hovel_lint_sources",
    srcs = [
        "BUILD.bazel",
        "config.go",
        "config_test.go",
    ],
    visibility = ["//tools/lint:__pkg__"],
)
# END generated lint sources
