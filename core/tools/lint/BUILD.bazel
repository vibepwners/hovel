load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load(":sources.bzl", "LINT_SOURCE_GROUPS")

package(default_visibility = ["//visibility:public"])

exports_files(["requirements.in"])

filegroup(
    name = "source_files",
    srcs = LINT_SOURCE_GROUPS,
)

py_binary(
    name = "lint_action_runner",
    srcs = ["lint_action_runner.py"],
)

py_binary(
    name = "format_rust_workspace",
    srcs = ["format_rust_workspace.py"],
    args = ["--rustfmt=$(rootpath @rules_rust//tools/upstream_wrapper:rustfmt)"],
    data = ["@rules_rust//tools/upstream_wrapper:rustfmt"],
    python_version = "PY3",
)

py_binary(
    name = "format_squatter_c",
    srcs = ["format_squatter_c.py"],
    python_version = "PY3",
    deps = ["@lint_pypi//clang_format"],
)

py_binary(
    name = "golangci_lint_workspace",
    srcs = ["golangci_lint_workspace.py"],
    args = [
        "--golangci-lint=$(rootpath @golangci_lint_linux_amd64//:golangci_lint_bin)",
        "--go=$(rootpath @go_sdk//:bin/go)",
    ],
    data = [
        "@go_sdk//:bin/go",
        "@golangci_lint_linux_amd64//:golangci_lint_bin",
    ],
    python_version = "PY3",
)

py_binary(
    name = "gofmt_workspace",
    srcs = ["gofmt_workspace.py"],
    args = ["--gofmt=$(rootpath @go_sdk//:bin/gofmt)"],
    data = ["@go_sdk//:bin/gofmt"],
    python_version = "PY3",
)

py_binary(
    name = "run_squatter_clang_tidy",
    srcs = ["run_squatter_clang_tidy.py"],
    python_version = "PY3",
)

py_binary(
    name = "run_squatter_complexity",
    srcs = ["run_squatter_complexity.py"],
    python_version = "PY3",
    deps = ["@lint_pypi//lizard"],
)

py_binary(
    name = "run_squatter_cppcheck",
    srcs = ["run_squatter_cppcheck.py"],
    python_version = "PY3",
    deps = [
        "@lint_pypi//cppcheck",
        "@lint_pypi//importlib_metadata",
    ],
)

py_binary(
    name = "run_squatter_format_check",
    srcs = ["run_squatter_format_check.py"],
    python_version = "PY3",
    deps = ["@lint_pypi//clang_format"],
)

py_binary(
    name = "ruff",
    srcs = ["run_ruff.py"],
    data = ["@lint_pypi//ruff:extracted_whl_files"],
    main = "run_ruff.py",
    python_version = "PY3",
)

py_binary(
    name = "python_check",
    srcs = ["run_python_check.py"],
    args = [
        "--ruff=$(rootpath :ruff)",
        "--mypy=$(rootpath :mypy)",
        "--pydoclint=$(rootpath :pydoclint)",
    ],
    data = [
        "stubs/pytest/__init__.pyi",
        ":mypy",
        ":pydoclint",
        ":ruff",
    ],
    main = "run_python_check.py",
    python_version = "PY3",
)

py_console_script_binary(
    name = "clang_format",
    pkg = "@lint_pypi//clang_format",
    python_version = "3.12",
    script = "clang-format",
)

py_console_script_binary(
    name = "mypy",
    pkg = "@lint_pypi//mypy",
    python_version = "3.12",
    script = "mypy",
)

py_console_script_binary(
    name = "pydoclint",
    pkg = "@lint_pypi//pydoclint",
    python_version = "3.12",
    script = "pydoclint",
)

# BEGIN generated lint sources
filegroup(
    name = "hovel_lint_sources",
    srcs = [
        "BUILD.bazel",
        "format_rust_workspace.py",
        "format_squatter_c.py",
        "go_modules.bzl",
        "gofmt_workspace.py",
        "golangci_lint_workspace.py",
        "lint_action.bzl",
        "lint_action_runner.py",
        "requirements.in",
        "requirements_lock.txt",
        "run_python_check.py",
        "run_ruff.py",
        "run_squatter_clang_tidy.py",
        "run_squatter_complexity.py",
        "run_squatter_cppcheck.py",
        "run_squatter_format_check.py",
        "sources.bzl",
        "squatter_clang_tidy.bzl",
        "static_checks.bzl",
        "stubs/pytest/__init__.pyi",
        "tools.go",
    ],
    visibility = ["//tools/lint:__pkg__"],
)
# END generated lint sources
