load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":wheel.bzl", "hovel_wheel")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "wheel_writer",
    srcs = ["build_hovel_wheel.py"],
    main = "build_hovel_wheel.py",
)

[
    hovel_wheel(
        name = "wheel_" + platform,
        binary = "//cmd/hovel:hovel_" + platform,
        binary_name = "hovel.exe" if platform.startswith("windows") else "hovel",
        platform_tag = tag,
    )
    for platform, tag in [
        ("linux_amd64", "manylinux_2_28_x86_64"),
        ("linux_arm64", "manylinux_2_28_aarch64"),
        ("darwin_arm64", "macosx_11_0_arm64"),
        ("windows_amd64", "win_amd64"),
        ("windows_arm64", "win_arm64"),
    ]
]

py_binary(
    name = "materialize_wheels",
    srcs = ["materialize_wheels.py"],
    args = ["--wheel-directory=$(rootpath :wheel_" + platform + ")" for platform in [
        "linux_amd64",
        "linux_arm64",
        "darwin_arm64",
        "windows_amd64",
        "windows_arm64",
    ]],
    data = [":wheel_" + platform for platform in [
        "linux_amd64",
        "linux_arm64",
        "darwin_arm64",
        "windows_amd64",
        "windows_arm64",
    ]],
)

py_binary(
    name = "upver",
    srcs = ["upver.py"],
    main = "upver.py",
    python_version = "PY3",
)

py_binary(
    name = "build_hovel_wheel",
    srcs = ["build_hovel_wheel.py"],
    args = ["--binary=$(rootpath //cmd/hovel:hovel)"],
    data = [
        "//:version_file",
        "//cmd/hovel",
    ],
    main = "build_hovel_wheel.py",
    python_version = "PY3",
)

py_binary(
    name = "build_hovel_wheel_linux_amd64",
    srcs = ["build_hovel_wheel.py"],
    args = [
        "--binary=$(rootpath //cmd/hovel:hovel_linux_amd64)",
        "--platform-tag=manylinux_2_28_x86_64",
        "--binary-name=hovel",
    ],
    data = [
        "//:version_file",
        "//cmd/hovel:hovel_linux_amd64",
    ],
    main = "build_hovel_wheel.py",
    python_version = "PY3",
)

py_binary(
    name = "build_hovel_wheel_linux_arm64",
    srcs = ["build_hovel_wheel.py"],
    args = [
        "--binary=$(rootpath //cmd/hovel:hovel_linux_arm64)",
        "--platform-tag=manylinux_2_28_aarch64",
        "--binary-name=hovel",
    ],
    data = [
        "//:version_file",
        "//cmd/hovel:hovel_linux_arm64",
    ],
    main = "build_hovel_wheel.py",
    python_version = "PY3",
)

py_binary(
    name = "build_hovel_wheel_darwin_arm64",
    srcs = ["build_hovel_wheel.py"],
    args = [
        "--binary=$(rootpath //cmd/hovel:hovel_darwin_arm64)",
        "--platform-tag=macosx_11_0_arm64",
        "--binary-name=hovel",
    ],
    data = [
        "//:version_file",
        "//cmd/hovel:hovel_darwin_arm64",
    ],
    main = "build_hovel_wheel.py",
    python_version = "PY3",
)

py_binary(
    name = "build_hovel_wheel_windows_amd64",
    srcs = ["build_hovel_wheel.py"],
    args = [
        "--binary=$(rootpath //cmd/hovel:hovel_windows_amd64)",
        "--platform-tag=win_amd64",
        "--binary-name=hovel.exe",
    ],
    data = [
        "//:version_file",
        "//cmd/hovel:hovel_windows_amd64",
    ],
    main = "build_hovel_wheel.py",
    python_version = "PY3",
)

py_binary(
    name = "build_hovel_wheel_windows_arm64",
    srcs = ["build_hovel_wheel.py"],
    args = [
        "--binary=$(rootpath //cmd/hovel:hovel_windows_arm64)",
        "--platform-tag=win_arm64",
        "--binary-name=hovel.exe",
    ],
    data = [
        "//:version_file",
        "//cmd/hovel:hovel_windows_arm64",
    ],
    main = "build_hovel_wheel.py",
    python_version = "PY3",
)

py_test(
    name = "upver_test",
    size = "small",
    srcs = [
        "upver.py",
        "upver_test.py",
    ],
    main = "upver_test.py",
    python_version = "PY3",
)

# BEGIN generated lint sources
filegroup(
    name = "hovel_lint_sources",
    srcs = [
        "BUILD.bazel",
        "build_hovel_wheel.py",
        "materialize_wheels.py",
        "upver.py",
        "upver_test.py",
        "wheel.bzl",
    ],
    visibility = ["//tools/lint:__pkg__"],
)
# END generated lint sources
